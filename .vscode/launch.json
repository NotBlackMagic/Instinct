{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Instinct",
			"type": "stlinkgdbtarget",
			"request": "launch",
			"origin": "snippet",
			"device": "STM32N657",       
			"deviceCore": "Cortex-M55",
			"cwd": "${workspaceFolder}",

			"preBuild": "${command:st-stm32-ide-debug-launch.build}",

			"runEntry": "main", // Set in BOOT_Application

			"svdPath": "C:/ST/STM32CubeCLT_1.19.0/STMicroelectronics_CMSIS_SVD/STM32N657.svd", // Replace with your .svd path
			//"svdPath": "C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/SVD/STM32N657.svd", // Replace with your .svd path

			"serverArgs": [
				"-m",
				"1"
				//"-el", "${workspaceFolder}/build/Debug/Loader/PlumaLoader.stldr"
			],

			"overrideLaunchCommands": [
				"-target-download",
				"monitor halt"
			],

			"imagesAndSymbols": [
				{
					"symbolFileName": "${workspaceFolder}/build/Debug/Instinct/Instinct.elf",
					"imageFileName": "${workspaceFolder}/build/Debug/Instinct/Instinct.elf",
					"format": "elf"
				}
			]
		}
	]
}