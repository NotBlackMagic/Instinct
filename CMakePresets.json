{
	"version": 3,
	"configurePresets": [
		{
			"name": "default",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "Debug-XIP",
			"inherits": "default",
			"displayName": "Config: Debug XIP",
			"binaryDir": "${sourceDir}/build/Debug-XIP",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"EXEC_TARGET": "XIP"
			}
		},
		{
			"name": "Debug-SRAM",
			"inherits": "default",
			"displayName": "Config: Debug SRAM",
			"binaryDir": "${sourceDir}/build/Debug-SRAM",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"EXEC_TARGET": "SRAM"
			}
		}
	],
	"buildPresets": [
		{
			"name": "Build-Instinct-XIP",
			"displayName": "Build: Instinct (XIP Debug)",
			"configurePreset": "Debug-XIP",
			"targets": ["Instinct"]
		},
		{
			"name": "Build-Instinct-SRAM",
			"displayName": "Build: Instinct (SRAM Debug)",
			"configurePreset": "Debug-SRAM",
			"targets": ["Instinct"]
		},
		{
			"name": "Build-Boot-Debug",
			"displayName": "Build: FSBL (Debug)",
			"configurePreset": "Debug-XIP",
			"targets": ["Boot"]
		},
		{
			"name": "Build-Loader-Debug",
			"displayName": "Build: Flash Loader (Debug)",
			"configurePreset": "Debug-XIP",
			"targets": ["Loader"]
		}			
	]
}